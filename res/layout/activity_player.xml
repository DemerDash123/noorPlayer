<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:layoutDirection="ltr">

    <TextureView
        android:id="@+id/video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/subtitle_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_subtitle"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:shadowColor="#FF000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:textColor="#FFFFFFFF"
        android:textDirection="firstStrong"
        android:textSize="20sp"
        android:visibility="gone" />

    <View
        android:id="@+id/gesture_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/buffering"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/center_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_panel"
        android:gravity="center_horizontal"
        android:minWidth="150dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/center_info_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:importantForAccessibility="no"
            android:tint="#FFFFFFFF" />

        <TextView
            android:id="@+id/center_info_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/center_info_bar"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="120dp"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progressBackgroundTint="#55FFFFFF"
            android:progressTint="@color/accent"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_gravity="top"
            android:background="@drawable/scrim_top" />

        <View
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_bottom" />

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/back_btn"
                style="@style/PlayerButton"
                android:contentDescription="@string/player_back"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/title_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/speed_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_badge"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/audio_btn"
                style="@style/PlayerButton"
                android:contentDescription="@string/player_audio"
                android:src="@drawable/ic_audiotrack" />

            <ImageButton
                android:id="@+id/subs_btn"
                style="@style/PlayerButton"
                android:contentDescription="@string/player_subtitles"
                android:src="@drawable/ic_subtitles" />

            <ImageButton
                android:id="@+id/speed_btn"
                style="@style/PlayerButton"
                android:contentDescription="@string/player_speed"
                android:src="@drawable/ic_speed" />

            <ImageButton
                android:id="@+id/more_btn"
                style="@style/PlayerButton"
                android:contentDescription="@string/player_more"
                android:src="@drawable/ic_more_vert" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/center_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/prev_btn"
                style="@style/PlayerButton"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/player_previous"
                android:src="@drawable/ic_skip_previous" />

            <FrameLayout
                android:id="@+id/rewind_btn"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/player_rewind"
                android:focusable="true">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_replay"
                    android:tint="#FFFFFFFF" />

                <TextView
                    android:id="@+id/rewind_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="3dp"
                    android:importantForAccessibility="no"
                    android:textColor="#FFFFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/play_pause_btn"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_circle"
                android:contentDescription="@string/player_play"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                android:tint="#FFFFFFFF" />

            <FrameLayout
                android:id="@+id/forward_btn"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/player_forward"
                android:focusable="true">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleX="-1"
                    android:src="@drawable/ic_replay"
                    android:tint="#FFFFFFFF" />

                <TextView
                    android:id="@+id/forward_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="3dp"
                    android:importantForAccessibility="no"
                    android:textColor="#FFFFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/next_btn"
                style="@style/PlayerButton"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/player_next"
                android:src="@drawable/ic_skip_next" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/position_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minWidth="56dp"
                    android:text="0:00"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/seek_bar"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:progressBackgroundTint="#55FFFFFF"
                    android:progressTint="@color/accent"
                    android:secondaryProgressTint="#88FFFFFF"
                    android:thumbTint="@color/accent" />

                <TextView
                    android:id="@+id/duration_text"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="56dp"
                    android:text="0:00"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/lock_btn"
                    style="@style/PlayerButton"
                    android:contentDescription="@string/player_lock"
                    android:src="@drawable/ic_lock_open" />

                <ImageButton
                    android:id="@+id/rotate_btn"
                    style="@style/PlayerButton"
                    android:contentDescription="@string/player_rotate"
                    android:src="@drawable/ic_rotate" />

                <ImageButton
                    android:id="@+id/aspect_btn"
                    style="@style/PlayerButton"
                    android:contentDescription="@string/player_aspect"
                    android:src="@drawable/ic_aspect" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/shot_btn"
                    style="@style/PlayerButton"
                    android:contentDescription="@string/more_screenshot"
                    android:src="@drawable/ic_camera" />

                <ImageButton
                    android:id="@+id/pip_btn"
                    style="@style/PlayerButton"
                    android:contentDescription="@string/player_pip"
                    android:src="@drawable/ic_pip" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <ImageButton
        android:id="@+id/unlock_btn"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="24dp"
        android:background="@drawable/bg_circle"
        android:contentDescription="@string/player_unlock"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_lock"
        android:tint="@color/accent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/resume_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="124dp"
        android:background="@drawable/bg_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/resume_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/resume_start_over"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/resume_start_over"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tip_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="32dp"
        android:background="@drawable/bg_panel"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:maxWidth="460dp"
        android:padding="20dp"
        android:text="@string/tip_gestures"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/error_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:background="@drawable/bg_panel"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_info"
            android:tint="@color/accent" />

        <TextView
            android:id="@+id/error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:maxWidth="400dp"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/error_open_with"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/err_open_with"
            android:textColor="@color/accent" />

        <Button
            android:id="@+id/error_next"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/err_next"
            android:textColor="@color/accent" />

        <Button
            android:id="@+id/error_close"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/err_close"
            android:textColor="@color/accent" />
    </LinearLayout>
</FrameLayout>
